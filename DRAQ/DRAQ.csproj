<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- build.bat passes -p:DraqTfm=net10.0-windows or net8.0-windows depending on the installed SDK -->
    <TargetFramework Condition="'$(DraqTfm)' == ''">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(DraqTfm)' != ''">$(DraqTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DRAQ</AssemblyName>
    <RootNamespace>DRAQ</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\assets\draq.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- Bundled tools: copied next to DRAQ.exe in a "tools" folder (build.bat downloads them into ..\tools first). -->
  <ItemGroup>
    <None Include="..\tools\yt-dlp\yt-dlp.exe" Condition="Exists('..\tools\yt-dlp\yt-dlp.exe')" Link="tools\yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\ffmpeg\ffmpeg.exe" Condition="Exists('..\tools\ffmpeg\ffmpeg.exe')" Link="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\ffmpeg\ffprobe.exe" Condition="Exists('..\tools\ffmpeg\ffprobe.exe')" Link="tools\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\aria2\aria2c.exe" Condition="Exists('..\tools\aria2\aria2c.exe')" Link="tools\aria2c.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\deno\deno.exe" Condition="Exists('..\tools\deno\deno.exe')" Link="tools\deno.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\draq.ico" Link="assets\draq.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

