<Window x:Class="DRAQ.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download history" Width="1100" Height="600" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Clear history" Click="Clear_Click" />
            <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenFolder_Click" />
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="3" />
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" />
        </DockPanel>
        <DataGrid x:Name="Grid" Margin="0,8,0,0" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText, Mode=OneWay}" Width="130" />
                <DataGridTextColumn Header="Filename" Binding="{Binding FileName, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="60" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="80" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="80" />
                <DataGridTextColumn Header="Quality" Binding="{Binding Quality, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Error" Binding="{Binding Error, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

