<UserControl x:Class="DRAQ.Views.TorrentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DRAQ.Views">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Magnet link" VerticalAlignment="Center" Margin="3" />
                <TextBox x:Name="MagnetBox" Grid.Column="1" />
                <Button Grid.Column="2" Content="Paste" Click="Paste_Click" />

                <TextBlock Text=".torrent file" Grid.Row="1" VerticalAlignment="Center" Margin="3" />
                <TextBox x:Name="FileBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
                <Button Grid.Row="1" Grid.Column="2" Content="Choose file..." Click="ChooseFile_Click" />

                <TextBlock Text="Save to" Grid.Row="2" VerticalAlignment="Center" Margin="3" />
                <TextBox x:Name="DestBox" Grid.Row="2" Grid.Column="1" />
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="Browse_Click" />
            </Grid>
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Start" Padding="22,6" FontWeight="SemiBold" Click="Start_Click" />
                <Button Content="Pause" Click="Pause_Click" />
                <Button Content="Resume" Click="Resume_Click" />
                <Button Content="Cancel" Click="Cancel_Click" />
                <Button Content="Remove" Click="Remove_Click" />
                <TextBlock x:Name="Msg" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}" />
            </WrapPanel>
        </StackPanel>
        <views:QueueGrid x:Name="TGrid" />
    </DockPanel>
</UserControl>

