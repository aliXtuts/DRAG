<Window x:Class="DRAQ.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename episodes" Width="1050" Height="680" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="3,0,0,6"
                   Text="These are the real files currently in the folder. Type the episode number of each file yourself. Nothing is changed on disk until you press Save / Rename All." />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Folder" VerticalAlignment="Center" Margin="3" />
            <TextBox x:Name="FolderBox" Grid.Column="1" />
            <Button Grid.Column="2" Content="Browse..." Click="Browse_Click" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <CheckBox x:Name="SubBox" Content="Include subfolders" />
                <Button Content="Reload files" Click="Reload_Click" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Common name" VerticalAlignment="Center" Margin="3" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontSize="14"
                     ToolTip="Example: PARIZAD - DRAMA - 480P- ALI MOBILE   gives   1. PARIZAD - DRAMA - 480P- ALI MOBILE.mp4" />
        </Grid>

        <DataGrid x:Name="ItemsGrid" Grid.Row="2" Margin="0,8,0,0" CanUserSortColumns="False" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Original filename" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Subfolder" Binding="{Binding RelDir, Mode=OneWay}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" IsReadOnly="True" Width="75" />
                <DataGridTextColumn Header="Hint" Binding="{Binding SuggestedText, Mode=OneWay}" IsReadOnly="True" Width="50" />
                <DataGridTextColumn Header="Episode (type it)" Binding="{Binding EpisodeText, UpdateSourceTrigger=LostFocus}" Width="110" />
                <DataGridTextColumn Header="New name" Binding="{Binding NewName, Mode=OneWay}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,8,0,0" Background="{DynamicResource PanelBg}" Padding="8" MinHeight="70" MaxHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Text="Assign the episode numbers, enter the common name, then press Check or Save." />
            </ScrollViewer>
        </Border>

        <WrapPanel Grid.Row="4" Margin="0,6,0,0">
            <Button Content="Fill from hints" Click="FillHints_Click" ToolTip="Copy the detected numbers (Hint column) into the Episode column - you can still correct them" />
            <Button Content="Clear numbers" Click="Clear_Click" />
            <Button Content="Sort by episode" Click="Sort_Click" />
            <Button Content="Check plan" Click="Check_Click" />
            <Button Content="Save / Rename All" Padding="20,5" FontWeight="SemiBold" Click="Save_Click" />
            <Button Content="Close" Click="Close_Click" />
        </WrapPanel>
    </Grid>
</Window>

