<Window x:Class="DRAQ.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import existing folder" Width="980" Height="640" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="3,0,0,6"
                   Text="DRAQ scans the folder (including subfolders) and lists EVERY video file it finds. Importing only registers the files in DRAQ - nothing is renamed, moved or changed on disk." />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Folder" VerticalAlignment="Center" Margin="3" />
            <TextBox x:Name="FolderBox" Grid.Column="1" />
            <Button Grid.Column="2" Content="Browse..." Click="Browse_Click" />
            <Button Grid.Column="3" Content="Scan folder" FontWeight="SemiBold" Click="Scan_Click" />
            <TextBlock x:Name="NameLabel" Text="Name" Grid.Row="1" VerticalAlignment="Center" Margin="3" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" />
            <StackPanel x:Name="SeasonPanel" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="Season" VerticalAlignment="Center" Margin="6,0,2,0" />
                <TextBox x:Name="SeasonBox" Width="50" Text="1" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="FilesGrid" Grid.Row="2" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File (relative to folder)" Binding="{Binding RelPath, Mode=OneWay}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="Episode (detected - correct it)" Binding="{Binding EpisodeText, UpdateSourceTrigger=LostFocus}" Width="190" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="ImportButton" Content="Import selected files" Padding="18,5" FontWeight="SemiBold" Click="Import_Click" IsEnabled="False" />
                <Button Content="Cancel" Click="Cancel_Click" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="Select All" Click="SelectAll_Click" />
                <Button Content="Select None" Click="SelectNone_Click" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Muted}" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>

