<UserControl x:Class="DRAQ.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DRAQ.Views">
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="Pause" Click="Pause_Click" />
            <Button Content="Resume" Click="Resume_Click" />
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Retry" Click="Retry_Click" />
            <Button Content="Remove" Click="Remove_Click" />
            <Separator Width="10" Visibility="Hidden" />
            <Button Content="Move up" Click="Up_Click" />
            <Button Content="Move down" Click="Down_Click" />
            <Separator Width="10" Visibility="Hidden" />
            <Button Content="Pause all" Click="PauseAll_Click" />
            <Button Content="Resume all" Click="ResumeAll_Click" />
            <Button Content="Retry failed" Click="RetryFailed_Click" />
            <Button Content="Clear finished" Click="ClearFinished_Click" ToolTip="Remove completed and cancelled entries from the list (files are kept)" />
            <TextBlock Text="Priority of selected:" VerticalAlignment="Center" Margin="14,0,2,0" />
            <ComboBox x:Name="PriorityBox" Width="90" SelectionChanged="Priority_Changed">
                <ComboBoxItem Content="Low" />
                <ComboBoxItem Content="Normal" />
                <ComboBoxItem Content="High" />
            </ComboBox>
        </WrapPanel>
        <views:QueueGrid x:Name="QGrid" />
    </DockPanel>
</UserControl>

