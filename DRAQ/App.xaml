<Application x:Class="DRAQ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="AppBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBg" Color="#F5F7FA" />
        <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB" />
        <SolidColorBrush x:Key="MainText" Color="#111827" />
        <SolidColorBrush x:Key="Muted" Color="#6B7280" />
        <SolidColorBrush x:Key="GridLine" Color="#E5E7EB" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="UserControl">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Background" Value="{DynamicResource ControlBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ControlBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ControlBg}" />
                        <Setter Property="Foreground" Value="{DynamicResource MainText}" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelBg}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Background" Value="{DynamicResource ControlBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
            <Setter Property="RowBackground" Value="{DynamicResource ControlBg}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBg}" />
            <Setter Property="AlternationCount" Value="2" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
            <Setter Property="Background" Value="{DynamicResource ControlBg}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33436B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MainText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="Padding" Value="6,5" />
        </Style>
    </Application.Resources>
</Application>

